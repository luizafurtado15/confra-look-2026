rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ehFotografo() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().papel == 'fotografo';
    }

    function juri() {
      return ['Gabriela Maria', 'Luciana Félix'];
    }

    // Só conta como jurado quem está na lista atual do júri.
    function ehJurado() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().papel == 'jurado'
        && perfil().nome in juri();
    }

    function notaValida(n) {
      return n is int && n >= -1 && n <= 5;
    }

    // Perfil do usuário. Cada conta só lê o próprio perfil.
    // Criação pela página: só os nomes do júri, sempre com papel "jurado".
    // Fotógrafo (Fernando) é criado direto no console do Firebase.
    match /usuarios/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create: if logado()
        && request.auth.uid == uid
        && request.resource.data.papel == 'jurado'
        && request.resource.data.nome in juri()
        && request.resource.data.keys().hasOnly(['nome', 'papel', 'email']);
      allow update, delete: if false;
    }

    // Inscrições dos looks: fotógrafo cria/remove, jurados leem.
    match /participantes/{id} {
      allow read: if ehFotografo() || ehJurado();
      allow create: if ehFotografo()
        && request.resource.data.keys().hasOnly(['nome', 'foto', 'criadoPor', 'criadoEm'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.foto is string
        && request.resource.data.foto.size() < 900000
        && request.resource.data.criadoPor == request.auth.uid;
      allow update: if false;
      allow delete: if ehFotografo();
    }

    // Notas: cada jurado só grava as próprias notas, de 0 a 5 por critério (-1 = ainda sem nota).
    match /votos/{id} {
      allow read: if ehJurado();
      allow create, update: if ehJurado()
        && id == request.auth.uid + '_' + request.resource.data.participanteId
        && request.resource.data.juradoUid == request.auth.uid
        && request.resource.data.juradoNome == perfil().nome
        && exists(/databases/$(database)/documents/participantes/$(request.resource.data.participanteId))
        && request.resource.data.keys().hasOnly(['juradoUid', 'juradoNome', 'participanteId', 'scores', 'atualizadoEm'])
        && request.resource.data.scores.keys().hasOnly(['fidelidade', 'capricho', 'criatividade', 'conjunto'])
        && notaValida(request.resource.data.scores.fidelidade)
        && notaValida(request.resource.data.scores.capricho)
        && notaValida(request.resource.data.scores.criatividade)
        && notaValida(request.resource.data.scores.conjunto);
      allow delete: if false;
    }
  }
}
